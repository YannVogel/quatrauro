{
  "name": "quatrauro",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint && prettier --check .",
    "format": "prettier --write .",
    "test": "jest",
    "backtest": "node pipeline/backtest/run.ts"
  },
  "dependencies": {
    "@date-fns/utc": "^2.1.1",
    "date-fns": "^4.4.0",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@shared/(.*)$": "<rootDir>/shared/$1"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/pipeline/backtest/.cache/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/android/",
      "<rootDir>/ios/"
    ]
  }
}
