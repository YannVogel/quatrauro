{
  "name": "quatrauro",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint && prettier --check .",
    "format": "prettier --write .",
    "test": "jest",
    "backtest": "node pipeline/backtest/run.ts",
    "brand:export": "node scripts/brand/export.ts"
  },
  "dependencies": {
    "@date-fns/utc": "^2.1.1",
    "@expo-google-fonts/outfit": "^0.4.3",
    "date-fns": "^4.4.0",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "lucide-react-native": "^1.74.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@shared/(.*)$": "<rootDir>/shared/$1",
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/pipeline/backtest/.cache/",
      "<rootDir>/android/",
      "<rootDir>/ios/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/android/",
      "<rootDir>/ios/"
    ]
  }
}
